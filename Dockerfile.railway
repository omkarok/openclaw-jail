FROM node:22.22.0-bookworm

ARG OPENCLAW_VERSION=2026.5.28
ARG PLAYWRIGHT_VERSION=1.58.2
# As of openclaw 2026.4.x, two previously-bundled extensions moved out into
# separately-published scoped npm packages whose version stream tracks
# openclaw releases. Pin each in lockstep with OPENCLAW_VERSION.
ARG ACPX_VERSION=2026.5.28
ARG WHATSAPP_VERSION=2026.5.28

# Install openclaw globally (read-only FS safe — binary in /usr/local/bin)
RUN corepack enable && npm install -g openclaw@${OPENCLAW_VERSION}

# Pre-bake @openclaw/acpx and @openclaw/whatsapp so they are discovered by
# openclaw's built-artifact plugin scanner (resolveBundledPluginScanDir
# in bundled-DdbF6Bpc.js: when RUNNING_FROM_BUILT_ARTIFACT is true it ONLY
# scans <openclaw>/dist/extensions/, never <openclaw>/extensions/).
#
# Each plugin dir must mirror the layout of bundled plugins (compare to
# the in-tree `signal` plugin): flat top-level `index.js` + sibling
# compiled chunks, plus `openclaw.plugin.json`, `package.json`, and any
# `node_modules/` the plugin bundles. The npm tarball ships the compiled
# code under `package/dist/` so we npm-pack, extract to a scratch dir,
# then copy `dist/*` to the plugin root and `package.json` /
# `openclaw.plugin.json` / `node_modules/` (if any) alongside.
#
# `openclaw.extensions[0]` in package.json is `"./index.ts"` for both —
# openclaw rewrites the extension to `.js` and looks in the plugin root,
# which is what we set up here.
RUN set -eux \
 && PLUGINS_DIR=/usr/local/lib/node_modules/openclaw/dist/extensions \
 && mkdir -p "$PLUGINS_DIR" \
 && cd /tmp \
 && npm pack @openclaw/acpx@${ACPX_VERSION} @openclaw/whatsapp@${WHATSAPP_VERSION} \
 && for spec in "acpx:${ACPX_VERSION}" "whatsapp:${WHATSAPP_VERSION}"; do \
      id="${spec%%:*}"; ver="${spec##*:}"; \
      tarball="openclaw-${id}-${ver}.tgz"; \
      scratch="/tmp/extract-${id}"; \
      dest="$PLUGINS_DIR/${id}"; \
      mkdir -p "$scratch" "$dest"; \
      tar -xzf "$tarball" -C "$scratch"; \
      cp -a "$scratch/package/dist/." "$dest/"; \
      cp "$scratch/package/openclaw.plugin.json" "$dest/"; \
      cp "$scratch/package/package.json" "$dest/"; \
      if [ -d "$scratch/package/node_modules" ]; then \
        cp -a "$scratch/package/node_modules" "$dest/node_modules"; \
      fi; \
      rm -rf "$scratch" "$tarball"; \
      echo "==> Pre-baked $id: $(ls $dest | head -5)"; \
    done

# Install Playwright OS-level deps
RUN npm install -g playwright@${PLAYWRIGHT_VERSION} --ignore-scripts && \
    playwright install-deps chromium

# Bake Chromium binary into the image (avoids runtime download on cold start)
# PLAYWRIGHT_BROWSERS_PATH overrides ~/.cache/ms-playwright so the browser
# lives in the image layer, not on the volume.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN npx playwright@${PLAYWRIGHT_VERSION} install chromium

# Create log and script directories (root-owned in image layer, fine since
# entrypoint chowns /var/log/openclaw to node at runtime)
RUN mkdir -p /var/log/openclaw /opt/openclaw-scripts

# Copy startup scripts into image (not on volume — always present after deploy)
COPY scripts/railway-entrypoint.sh /railway-entrypoint.sh
COPY scripts/railway-start.sh /opt/openclaw-scripts/start.sh
RUN chmod +x /railway-entrypoint.sh /opt/openclaw-scripts/start.sh

WORKDIR /home/node

# Entrypoint runs as root to fix volume permissions, then drops to node (uid 1000)
ENTRYPOINT ["/railway-entrypoint.sh"]
CMD ["/opt/openclaw-scripts/start.sh"]
